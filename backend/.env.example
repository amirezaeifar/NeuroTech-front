# Application
APP_NAME=NeuroTech Backend
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=change-this-secret
CORS_ORIGINS=http://localhost:5173

# MariaDB / MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=neurotech_user
DB_PASS=neurotech_pass
DB_NAME=neurotech_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-this-jwt-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=neurotech
JWT_AUDIENCE=neurotech-users
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30
JWT_LEEWAY_SECONDS=10
JWT_REFRESH_COOKIE_NAME=neurotech_refresh_token
JWT_REFRESH_COOKIE_SECURE=false
JWT_REFRESH_COOKIE_SAMESITE=Lax
JWT_REFRESH_COOKIE_PATH=/auth

# OTP
OTP_EXPIRE_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_LENGTH=6
OTP_DEVELOPMENT_MODE=true

# Password policy
PASSWORD_MIN_LENGTH=8

# Sensitive-data encryption
DATA_ENCRYPTION_KEY=replace-with-valid-encryption-key

# Development administrator
DEV_ADMIN_FIRST_NAME=Development
DEV_ADMIN_LAST_NAME=Admin
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PHONE=
DEV_ADMIN_PASSWORD=change-this-password
